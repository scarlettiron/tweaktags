{
  "name": "tweaktags-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "TweakTags, a self-hosted inline CMS and visual content editor for Next.js, React, and plain HTML. Edit website content directly on the live page.",
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "pack:all": "rm -rf tweaktags-pack && mkdir -p tweaktags-pack && for p in core db-postgres db-mysql db-mariadb db-sqlite auth-jwt auth-aws-cognito storage-s3 server browser vanillajs react next cli tweaktags; do (cd packages/$p && pnpm pack --pack-destination ../../tweaktags-pack); done && echo 'Tarballs written to ./tweaktags-pack'",
    "build:pack": "pnpm build && pnpm pack:all",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:adapters": "vitest run tests/adapters.test.ts",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down -v",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod",
    "audit:high": "pnpm audit --audit-level high",
    "audit:fix": "pnpm audit --fix",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@stylistic/eslint-plugin": "^2.10.1",
    "@types/node": "^22.9.0",
    "@tweaktags/auth-aws-cognito": "workspace:*",
    "@tweaktags/auth-jwt": "workspace:*",
    "@tweaktags/browser": "workspace:*",
    "@tweaktags/core": "workspace:*",
    "@tweaktags/db-mysql": "workspace:*",
    "@tweaktags/db-postgres": "workspace:*",
    "@tweaktags/db-sqlite": "workspace:*",
    "@tweaktags/server": "workspace:*",
    "@tweaktags/vanillajs": "workspace:*",
    "eslint": "^9.14.0",
    "happy-dom": "^15.11.6",
    "mysql2": "^3.11.4",
    "pg": "^8.13.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  }
}
