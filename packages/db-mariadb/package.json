{
  "name": "@tweaktags/db-mariadb",
  "version": "1.2.0",
  "description": "MariaDB database adapter for TweakTags, the inline CMS for React, Next.js, and vanilla JavaScript. Installs and re-exports @tweaktags/db-mysql, since MariaDB speaks the MySQL protocol.",
  "keywords": [
    "tweaktags",
    "tweak-tags",
    "cms",
    "inline-cms",
    "content-management",
    "inline-editing",
    "in-place-editing",
    "editable-content",
    "typescript",
    "scarlett scott",
    "scarlettiron",
    "mariadb",
    "mysql",
    "database",
    "database-adapter"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tweaktags/db-mysql": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git",
    "directory": "packages/db-mariadb"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
