{
  "name": "@tweaktags/next",
  "version": "1.2.0",
  "description": "Inline CMS and visual content editor for Next.js and React. Edit text, rich text, and media right on the live page. Route handler plus React bindings in one package.",
  "keywords": [
    "tweaktags",
    "tweak-tags",
    "cms",
    "inline-cms",
    "content-management",
    "inline-editing",
    "in-place-editing",
    "editable-content",
    "typescript",
    "scarlett scott",
    "scarlettiron",
    "visual-editor",
    "website-editor",
    "page-editor",
    "wysiwyg",
    "rich-text-editor",
    "static-site",
    "next",
    "nextjs",
    "next.js",
    "react",
    "app-router",
    "route-handler"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tweaktags/core": "workspace:*",
    "@tweaktags/react": "workspace:*",
    "@tweaktags/server": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=16.14.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git",
    "directory": "packages/next"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
