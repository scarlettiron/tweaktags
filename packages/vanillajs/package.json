{
  "name": "@tweaktags/vanillajs",
  "version": "1.3.0",
  "description": "Self-hosted inline CMS and visual editor for plain HTML and JavaScript. Edit text, rich text, images, and website content directly on the live page. No framework, no build step.",
  "keywords": [
    "tweaktags",
    "tweak-tags",
    "cms",
    "inline-cms",
    "visual-cms",
    "self-hosted-cms",
    "lightweight-cms",
    "static-site-cms",
    "content-management",
    "content-editor",
    "website-editor",
    "website-cms",
    "page-editor",
    "inline-editing",
    "in-place-editing",
    "live-editing",
    "visual-editor",
    "wysiwyg",
    "nextjs",
    "next.js",
    "nextjs-cms",
    "react",
    "react-cms",
    "javascript",
    "vanilla-js",
    "rich-text",
    "rich-text-editor",
    "image-editor",
    "media",
    "tweak tags",
    "scarlett scott",
    "scarlettiron",
    "simple cms",
    "easy cms",
    "edit in place",
    "click to edit",
    "editable content",
    "no dashboard",
    "javascript cms",
    "html cms",
    "no framework",
    "script tag",
    "self-hosted",
    "html-cms",
    "editable-html",
    "cms-without-framework",
    "script-tag"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": "./dist/index.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tweaktags/browser": "workspace:*",
    "@tweaktags/core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git",
    "directory": "packages/vanillajs"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
