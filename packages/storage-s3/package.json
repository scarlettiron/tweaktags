{
  "name": "@tweaktags/storage-s3",
  "version": "1.2.0",
  "description": "Media uploads to S3 or any S3 compatible store for TweakTags, the inline CMS for React and Next.js. Uses short lived presigned uploads.",
  "keywords": [
    "tweaktags",
    "tweak-tags",
    "cms",
    "inline-cms",
    "content-management",
    "inline-editing",
    "in-place-editing",
    "editable-content",
    "typescript",
    "scarlett scott",
    "scarlettiron",
    "s3",
    "storage",
    "uploads",
    "presigned-url",
    "image-upload",
    "media"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tweaktags/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git",
    "directory": "packages/storage-s3"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
