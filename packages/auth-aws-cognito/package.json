{
  "name": "@tweaktags/auth-aws-cognito",
  "version": "1.5.0",
  "description": "AWS Cognito authentication for TweakTags, the self-hosted inline CMS for Next.js and React. Sign in editors against an existing Cognito user pool.",
  "keywords": [
    "tweaktags",
    "tweak-tags",
    "cms",
    "inline-cms",
    "visual-cms",
    "self-hosted-cms",
    "lightweight-cms",
    "static-site-cms",
    "content-management",
    "content-editor",
    "website-editor",
    "website-cms",
    "page-editor",
    "inline-editing",
    "in-place-editing",
    "live-editing",
    "visual-editor",
    "wysiwyg",
    "nextjs",
    "next.js",
    "nextjs-cms",
    "react",
    "react-cms",
    "javascript",
    "vanilla-js",
    "rich-text",
    "rich-text-editor",
    "image-editor",
    "media",
    "tweak tags",
    "scarlett scott",
    "scarlettiron",
    "auth",
    "authentication",
    "cognito",
    "aws-cognito",
    "amazon-cognito",
    "user-pool",
    "sso",
    "login",
    "aws",
    "aws-sdk",
    "amazon-web-services",
    "identity-provider",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tweaktags/core": "workspace:*",
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "aws-jwt-verify": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git",
    "directory": "packages/auth-aws-cognito"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
