{
  "name": "@tweaktags/auth-jwt",
  "version": "1.5.0",
  "description": "Email and password authentication for TweakTags, the self-hosted inline CMS for Next.js and React. Rotating JSON Web Tokens with bcrypt hashed passwords.",
  "keywords": [
    "tweaktags",
    "tweak-tags",
    "cms",
    "inline-cms",
    "visual-cms",
    "self-hosted-cms",
    "lightweight-cms",
    "static-site-cms",
    "content-management",
    "content-editor",
    "website-editor",
    "website-cms",
    "page-editor",
    "inline-editing",
    "in-place-editing",
    "live-editing",
    "visual-editor",
    "wysiwyg",
    "nextjs",
    "next.js",
    "nextjs-cms",
    "react",
    "react-cms",
    "javascript",
    "vanilla-js",
    "rich-text",
    "rich-text-editor",
    "image-editor",
    "media",
    "tweak tags",
    "scarlett scott",
    "scarlettiron",
    "auth",
    "authentication",
    "jwt",
    "json-web-token",
    "bcrypt",
    "login",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tweaktags/core": "workspace:*",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git",
    "directory": "packages/auth-jwt"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
