{
  "name": "@tweaktags/server",
  "version": "1.5.0",
  "description": "Node backend for TweakTags, the self-hosted inline CMS and visual editor for Next.js, React, and plain HTML. Mount it on any route, or run it standalone.",
  "keywords": [
    "tweaktags",
    "tweak-tags",
    "cms",
    "inline-cms",
    "visual-cms",
    "self-hosted-cms",
    "lightweight-cms",
    "static-site-cms",
    "content-management",
    "content-editor",
    "website-editor",
    "website-cms",
    "page-editor",
    "inline-editing",
    "in-place-editing",
    "live-editing",
    "visual-editor",
    "wysiwyg",
    "nextjs",
    "next.js",
    "nextjs-cms",
    "react",
    "react-cms",
    "javascript",
    "vanilla-js",
    "rich-text",
    "rich-text-editor",
    "image-editor",
    "media",
    "tweak tags",
    "scarlett scott",
    "scarlettiron",
    "node",
    "backend",
    "api",
    "request-handler",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tweaktags/auth-jwt": "workspace:*",
    "@tweaktags/core": "workspace:*",
    "@tweaktags/db-postgres": "workspace:*"
  },
  "peerDependencies": {
    "@tweaktags/auth-aws-cognito": "workspace:*",
    "@tweaktags/db-mysql": "workspace:*",
    "@tweaktags/db-sqlite": "workspace:*",
    "@tweaktags/storage-s3": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tweaktags/auth-aws-cognito": {
      "optional": true
    },
    "@tweaktags/db-mysql": {
      "optional": true
    },
    "@tweaktags/db-sqlite": {
      "optional": true
    },
    "@tweaktags/storage-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git",
    "directory": "packages/server"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
