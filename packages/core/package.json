{
  "name": "@tweaktags/core",
  "version": "1.2.0",
  "description": "Core of TweakTags, the inline CMS and visual content editor for React, Next.js, and vanilla JavaScript. Types, config loader, adapter interfaces, and the request handler.",
  "keywords": [
    "tweaktags",
    "tweak-tags",
    "cms",
    "inline-cms",
    "content-management",
    "inline-editing",
    "in-place-editing",
    "editable-content",
    "typescript",
    "scarlett scott",
    "scarlettiron",
    "config",
    "request-handler",
    "adapter",
    "types"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./loader": {
      "import": {
        "types": "./dist/loader.d.ts",
        "default": "./dist/loader.js"
      },
      "require": {
        "types": "./dist/loader.d.cts",
        "default": "./dist/loader.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "jiti": "^2.4.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Scarlett A. Scott",
    "url": "https://github.com/scarlettiron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scarlettiron/tweaktags.git",
    "directory": "packages/core"
  },
  "homepage": "https://scarlettiron.github.io/tweaktags",
  "bugs": {
    "url": "https://github.com/scarlettiron/tweaktags/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
